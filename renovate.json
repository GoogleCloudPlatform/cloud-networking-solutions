{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "before 6am on monday"
  ],
  "prCreation": "not-pending",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Batch all routine non-vulnerability updates across all package managers into a single weekly PR",
      "matchPackagePatterns": [
        "*"
      ],
      "groupName": "Weekly dependency updates",
      "groupSlug": "weekly-dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "groupName": null,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "groupName": "Weekly dependency updates",
    "groupSlug": "weekly-dependencies"
  }
}
