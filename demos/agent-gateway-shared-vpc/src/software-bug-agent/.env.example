# Copy this file to .env and fill in the values.
# Loaded automatically by deploy_agent.py and by `adk run` (natively).

# GCP project where the Reasoning Engine will be deployed.
PROJECT_ID=my-project-id

# Region for the Reasoning Engine (must match terraform region).
REGION=us-central1

# Cloud Run URL for the bug-tickets-mcp service (with /mcp suffix).
# Retrieve after terraform apply phase 1:
#   cd ../../terraform && terraform output -raw bug_tickets_mcp_url
BUG_TICKETS_MCP_URL=https://bug-tickets-mcp-xxxx-uc.a.run.app/mcp

# Gemini model for the root agent (defaults to gemini-2.5-flash).
# MODEL_NAME=gemini-2.5-flash
